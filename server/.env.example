# ──────────────────────────────────────────────────────────────────────
# Gemini (Google AI Studio) — needed ONLY when VISION_PROVIDER=gemini
# Get a key from https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_VERIFICATION_MODEL=gemini-flash-latest
GEMINI_DIAGNOSTIC_MODEL=gemini-flash-latest

# ──────────────────────────────────────────────────────────────────────
# GLM (z.ai Coding Plan) — needed for glm-mcp vision AND/OR glm reasoning
# Get a key from https://z.ai  (Coding Plan subscription)
# NOTE: must use the Coding Plan endpoint, NOT the PAYG endpoint
# ──────────────────────────────────────────────────────────────────────
GLM_API_KEY=YOUR_GLM_API_KEY_HERE
GLM_MODEL=glm-4.6
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MAX_TOKENS=16000

# ──────────────────────────────────────────────────────────────────────
# Groq (optional free vision alternative) — needed ONLY when VISION_PROVIDER=groq
# Get a key from https://console.groq.com  (free tier)
# ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# ──────────────────────────────────────────────────────────────────────
# PROVIDER SELECTION (the key configuration)
#
# VISION_PROVIDER:  who reads the chart image?
#   gemini  = Gemini Vision (needs GEMINI_API_KEY, 20 req/day free tier)
#   glm-mcp = GLM-4.6V via z.ai MCP server (needs only GLM_API_KEY) ← NO GEMINI
#   groq    = Groq vision model (needs GROQ_API_KEY, free)
#
# DIAGNOSTIC_PROVIDER: who reasons out the diagnosis?
#   gemini = Gemini (needs GEMINI_API_KEY)
#   glm    = GLM text reasoning (needs GLM_API_KEY)
#
# ── RECOMMENDED: fully Gemini-free ──
VISION_PROVIDER=glm-mcp
DIAGNOSTIC_PROVIDER=glm
#
# ── Alternative: Gemini for everything (fastest, needs working Gemini key) ──
# VISION_PROVIDER=gemini
# DIAGNOSTIC_PROVIDER=gemini
# ──────────────────────────────────────────────────────────────────────

# MCP server timeout (GLM-4.6V vision calls take 30-120s)
MCP_TIMEOUT_MS=180000

# ──────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
MAX_IMAGE_WIDTH=1600
MAX_UPLOAD_BYTES=15728640
REQUEST_TIMEOUT_MS=120000
